{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.example.invalid/horary/v1.2/accidental_response.schema.json",
  "title":"AccidentalConditionResponse 1.2",
  "type":"object","additionalProperties":false,
  "required":["schema_version","engine_version","chart_id","source_chart_hash","source_chart_hash_verified_by_this_module","accidental_profile","profile_sha256","calculation_input_sha256","planets","judgment_status","predictive_confidence","warnings"],
  "properties":{
    "schema_version":{"const":"1.2"},"engine_version":{"type":"string","minLength":1},
    "chart_id":{"type":"string","minLength":1},"source_chart_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "source_chart_hash_verified_by_this_module":{"const":false},
    "accidental_profile":{"const":"FRAWLEY_EARLY_ACCIDENTAL_V1_2_WITH_OLESHKO_SPEED_REFERENCE"},
    "profile_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "calculation_input_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "planets":{"type":"array","minItems":7,"maxItems":7,"items":{"type":"object","additionalProperties":false,
       "required":["planet","house","house_class","is_in_house_joy","house_joy_number","motion","solar","moon_phase","rule_ids"],
       "properties":{
          "planet":{"enum":["Sun","Moon","Mercury","Venus","Mars","Jupiter","Saturn"]},
          "house":{"type":"integer","minimum":1,"maximum":12},
          "house_class":{"enum":["STRONG_ANGULAR","MIDDLE_OR_NEUTRAL","WEAK"]},
          "is_in_house_joy":{"type":"boolean"},"house_joy_number":{"type":"integer","minimum":1,"maximum":12},
          "moon_phase":{"type":["string","null"],"enum":["NEW_MOON_BOUNDARY","FULL_MOON_BOUNDARY","WAXING","WANING",null]},
          "rule_ids":{"type":"array","items":{"type":"string"}},
          "motion":{"type":"object","additionalProperties":false,
            "required":["zodiacal_speed_deg_per_day","direction","reference_speed_deg_per_day","speed_ratio_abs","relative_speed","near_station_not_confirmed","retrograde_context","station_confirmed","rule_ids"],
            "properties":{
              "zodiacal_speed_deg_per_day":{"type":"number"},
              "direction":{"enum":["DIRECT","RETROGRADE","ZERO_INSTANTANEOUS_SPEED"]},
              "reference_speed_deg_per_day":{"type":"number","exclusiveMinimum":0},
              "speed_ratio_abs":{"type":"number","minimum":0},
              "relative_speed":{"enum":["NOT_ASSESSED_FOR_SUN","POSSIBLE_STATION_NEEDS_EPHEMERIS_BRACKETING","SLOW_BY_PROJECT_HEURISTIC","FAST_BY_PROJECT_HEURISTIC","NEAR_REFERENCE_SPEED"]},
              "near_station_not_confirmed":{"type":"boolean"},"retrograde_context":{"type":"string"},
              "station_confirmed":{"const":false},
              "rule_ids":{"type":"array","items":{"type":"string"}}
            }
          },
          "solar":{"type":"object","additionalProperties":false,
            "required":["state","distance_deg","same_sign","contact_trend","qualifiers","rule_ids"],
            "properties":{
              "state":{"enum":["NOT_APPLICABLE","CAZIMI","COMBUST","UNDER_BEAMS","OUTSIDE_BEAMS"]},
              "distance_deg":{"type":"number","minimum":0,"maximum":180},
              "same_sign":{"type":"boolean"},
              "contact_trend":{"enum":["NOT_APPLICABLE","APPLYING","SEPARATING","TREND_UNRESOLVED"]},
              "qualifiers":{"type":"array","items":{"type":"string"}},
              "rule_ids":{"type":"array","items":{"type":"string"}}
            }
          }
       }
     }
    },
    "judgment_status":{"const":"NOT_PERFORMED"},"predictive_confidence":{"type":"null"},
    "warnings":{"type":"array","minItems":1,"items":{"type":"string"}}
  }
}

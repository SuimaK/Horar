{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Career horary input for expert evidence review v1.9",
 "type":"object","additionalProperties":false,
 "required":["schema_version","question_id","chart_id","scenario_code","event_predicate","perspective","employment_state","employment_relation","money_context","evidence_refs"],
 "properties":{
  "schema_version":{"const":"1.9"},
  "question_id":{"type":"string","minLength":3,"maxLength":120},
  "chart_id":{"type":"string","minLength":3,"maxLength":120},
  "scenario_code":{"enum":["GET_JOB","ACCEPT_OFFER","KEEP_JOB","JOB_LOSS","CHANGE_JOB","PROMOTION","COMPARE_JOBS","BOSS_RELATION","SALARY_OUTLOOK","WAGE_PAYMENT","WORK_CONDITIONS"]},
  "event_predicate":{"enum":["JOB_OBTAINED","OFFER_SUITABILITY_SYMBOLIC","CURRENT_JOB_MAINTAINED","CURRENT_JOB_ENDED","JOB_CHANGED","PROMOTION_GRANTED","JOB_OPTIONS_COMPARED","BOSS_RELATION_ASSESSED","SALARY_CONDITIONS_ASSESSED","PAYMENT_RECEIVED","WORK_CONDITIONS_ASSESSED"]},
  "perspective":{"enum":["SELF","THIRD_PARTY"]},
  "employment_state":{"enum":["UNEMPLOYED","EMPLOYED","NOTICE_GIVEN","UNKNOWN"]},
  "employment_relation":{"enum":["EMPLOYEE","APPLICANT","SERVICE_PROVIDER","BUSINESS_OWNER","EMPLOYER","UNKNOWN"]},
  "money_context":{"enum":["EMPLOYER_PAYROLL","CLIENT_INVOICE","OWN_RESOURCES","UNKNOWN"]},
  "evidence_refs":{"type":"array","uniqueItems":true,"maxItems":100,"items":{"type":"string","minLength":2}},
  "outcome_criterion":{"type":["object","null"],"additionalProperties":false,"required":["defined","expert_reviewed"],"properties":{"defined":{"type":"boolean"},"expert_reviewed":{"type":"boolean"},"description":{"type":"string","maxLength":1000}}},
  "v17_route":{"type":["object","null"]}
 }
}

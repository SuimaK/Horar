{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/horary/contact_judgement_v15.schema.json",
  "title": "Conservative horary contact evidence v1.5",
  "type": "object",
  "required": ["schema_version","question_kind","question_classification","status","can_issue_client_verdict","final_prediction","timing_prediction","analysis","data_kind"],
  "properties": {
    "schema_version": {"const":"1.5"},
    "question_kind": {"enum":["MEETING_WITH_NAMED_PERSON","CONTACT_WITH_NAMED_PERSON","MESSAGE_FROM_NAMED_PERSON","PHYSICAL_LETTER_OR_PARCEL","DID_THEY_RECEIVE_MY_LETTER","VISITOR_ARRIVAL_AT_HOME"]},
    "status": {"enum":["NEEDS_EXPERT_REVIEW","TOPIC_MODULE_REQUIRED"]},
    "can_issue_client_verdict": {"const":false},
    "final_prediction": {"type":"null"},
    "timing_prediction": {"type":"null"},
    "question_classification": {"type":"object","required":["branch","rule_ids","ordinary_radical_third_used","message_delivery_house_assigned"]},
    "data_kind":{"enum":["REAL_EPHEMERIS","NO_ASTRONOMICAL_EVALUATION"]},
    "analysis":{"type":["object","null"]},
    "source_chart_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "source_chart_verified":{"const":true},
    "text_interpretation":{"type":"string"},
    "source_coverage":{"type":"object"}
  },
  "allOf": [{
    "if":{"properties":{"status":{"const":"NEEDS_EXPERT_REVIEW"}}},
    "then":{"required":["source_chart_hash","source_chart_verified","source_coverage","text_interpretation"],
            "properties":{"data_kind":{"const":"REAL_EPHEMERIS"},"analysis":{"type":"object"}}}
  },{
    "if":{"properties":{"status":{"const":"TOPIC_MODULE_REQUIRED"}}},
    "then":{"properties":{"data_kind":{"const":"NO_ASTRONOMICAL_EVALUATION"},"analysis":{"type":"null"}}}
  }]
}

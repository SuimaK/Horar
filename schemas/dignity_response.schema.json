{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/horary/v1.1/dignity_response.schema.json",
  "title": "DignityReceptionResult 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "module_version", "chart_id", "source_chart_hash", "source_chart_hash_verified_by_this_module", "sect", "dignity_table_profile", "profile_sha256", "calculation_input_sha256", "table_is_verified_against_frawley_2014", "placements", "directional_receptions", "self_dignities_and_self_debilities", "mutual_receptions", "judgment_status", "warnings", "rule_ids"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "module_version": {"type": "string"},
    "chart_id": {"type": "string"},
    "source_chart_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_chart_hash_verified_by_this_module": {"const": false},
    "sect": {"enum": ["DAY", "NIGHT"]},
    "dignity_table_profile": {"const": "OLESHKO_1999_P55"},
    "profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "calculation_input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "table_is_verified_against_frawley_2014": {"const": false},
    "placements": {"type": "array", "minItems": 7, "maxItems": 7,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["planet", "longitude_deg", "sign", "degree_in_sign", "dignity_owners", "own_essential_dignities", "own_essential_debilities", "peregrine", "rule_ids"],
        "properties": {
          "planet": {"enum": ["Sun", "Moon", "Mercury", "Venus", "Mars", "Jupiter", "Saturn"]},
          "longitude_deg": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
          "sign": {"type": "string"},
          "degree_in_sign": {"type": "number", "minimum": 0, "exclusiveMaximum": 30},
          "dignity_owners": {"type": "object", "additionalProperties": {"type": ["string", "null"]},
            "required": ["domicile", "exaltation", "triplicity", "term", "face", "detriment", "fall"]},
          "own_essential_dignities": {"type": "array", "items": {"enum": ["domicile", "exaltation", "triplicity", "term", "face"]}},
          "own_essential_debilities": {"type": "array", "items": {"enum": ["detriment", "fall"]}},
          "peregrine": {"type": "boolean"},
          "rule_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "directional_receptions": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "self_dignities_and_self_debilities": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "mutual_receptions": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["planet_a", "planet_b", "classification", "a_to_b", "b_to_a", "does_not_perfect_event", "rule_id"],
      "properties": {"planet_a": {"type": "string"}, "planet_b": {"type": "string"},
        "classification": {"enum": ["MUTUAL_POSITIVE", "MUTUAL_NEGATIVE", "MUTUAL_MIXED"]},
        "a_to_b": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/edge"}},
        "b_to_a": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/edge"}},
        "does_not_perfect_event": {"const": true}, "rule_id": {"type": "string"}
      }
    }},
    "judgment_status": {"const": "NOT_PERFORMED"},
    "warnings": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "rule_ids": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {"edge": {"type": "object", "additionalProperties": false,
    "required": ["from_planet", "to_planet", "dignity_kind", "polarity", "rule_id"],
    "properties": {
      "from_planet": {"type": "string"}, "to_planet": {"type": "string"},
      "dignity_kind": {"enum": ["domicile", "exaltation", "triplicity", "term", "face", "detriment", "fall"]},
      "polarity": {"enum": ["POSITIVE", "NEGATIVE"]},
      "rule_id": {"type": "string"}
    }
  }}
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Horary v1.3 EvidenceAssembly (non-predictive)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "engine_version", "chart_id", "source_chart_hash", "evidence_status", "source_chart_hash_verified", "final_prediction", "method_profile", "actors", "actor_count", "limitations"],
  "properties": {
    "schema_version": {"const": "1.3"},
    "engine_version": {"type": "string"},
    "chart_id": {"type": "string", "minLength": 1},
    "source_chart_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_status": {"const": "EVIDENCE_ASSEMBLED_NOT_JUDGED"},
    "source_chart_hash_verified": {"const": false},
    "final_prediction": {"type": "null"},
    "method_profile": {"type": "string", "minLength": 1},
    "actor_count": {"type": "integer", "minimum": 1},
    "actors": {"type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["actor_id", "planet", "own_essential_dignities", "own_essential_debilities", "accidental_house_class", "motion_direction", "solar_state", "context_flags", "receptions_outbound", "interpretive_warning"],
       "properties": {"actor_id": {"type":"string"}, "planet":{"type":"string","enum":["Sun","Moon","Mercury","Venus","Mars","Jupiter","Saturn"]},
        "own_essential_dignities":{"type":"array","items":{"type":"string"}},
        "own_essential_debilities":{"type":"array","items":{"type":"string"}},
        "accidental_house_class":{"type":"string"},"motion_direction":{"type":"string"},
        "solar_state":{"type":"string"},"context_flags":{"type":"array","items":{"type":"string"}},
        "receptions_outbound":{"type":"array","items":{"type":"object"}},
        "interpretive_warning":{"type":"string"}}}},
    "limitations": {"type":"array","minItems":1,"items":{"type":"string"}}
  }
}

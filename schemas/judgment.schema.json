{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/horary/v1.0/JudgmentRecord.schema.json",
  "title": "JudgmentRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "question_id",
    "method_profile",
    "processing_status",
    "judgment_status",
    "roles_locked",
    "event_assessment",
    "outcome_quality",
    "benefit_for_querent",
    "timing",
    "key_evidence",
    "counterevidence",
    "conditions",
    "unknowns",
    "calculation_version",
    "rule_set_hash"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "method_profile": {
      "enum": [
        "frawley_early",
        "oleshko_comparison"
      ]
    },
    "processing_status": {
      "enum": [
        "RESULT_READY",
        "NEEDS_CLARIFICATION",
        "NEEDS_EXPERT_REVIEW",
        "TOPIC_MODULE_REQUIRED",
        "SEARCH_INCOMPLETE",
        "SAFETY_LIMITED",
        "CALCULATION_ERROR"
      ]
    },
    "judgment_status": {
      "enum": [
        "YES",
        "NO",
        "CONDITIONAL",
        "UNDETERMINED",
        "NOT_APPLICABLE"
      ]
    },
    "roles_locked": {
      "type": "boolean"
    },
    "event_assessment": {
      "type": "string",
      "minLength": 1
    },
    "outcome_quality": {
      "enum": [
        "FAVORABLE",
        "UNFAVORABLE",
        "MIXED",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "benefit_for_querent": {
      "enum": [
        "FAVORABLE",
        "UNFAVORABLE",
        "MIXED",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "timing": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "range_start_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "range_end_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "key_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "rule_id",
          "source_kind",
          "chart_fact",
          "calculation_version",
          "input_hash"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "source_kind": {
            "enum": [
              "REAL_EPHEMERIS",
              "ARTIFICIAL_NUMERIC_FIXTURE",
              "HISTORICAL_REPRODUCTION",
              "SEMANTIC_CONTEXT",
              "METHOD_RULE"
            ]
          },
          "chart_fact": {
            "type": "string",
            "minLength": 1
          },
          "calculation_version": {
            "type": "string",
            "minLength": 1
          },
          "input_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "strength": {
            "enum": [
              "PRIMARY",
              "SECONDARY",
              "CONTEXTUAL"
            ]
          }
        }
      }
    },
    "counterevidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "rule_id",
          "source_kind",
          "chart_fact",
          "calculation_version",
          "input_hash"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "source_kind": {
            "enum": [
              "REAL_EPHEMERIS",
              "ARTIFICIAL_NUMERIC_FIXTURE",
              "HISTORICAL_REPRODUCTION",
              "SEMANTIC_CONTEXT",
              "METHOD_RULE"
            ]
          },
          "chart_fact": {
            "type": "string",
            "minLength": 1
          },
          "calculation_version": {
            "type": "string",
            "minLength": 1
          },
          "input_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "strength": {
            "enum": [
              "PRIMARY",
              "SECONDARY",
              "CONTEXTUAL"
            ]
          }
        }
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "condition_id",
          "status"
        ],
        "properties": {
          "condition_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "ESTABLISHED",
              "NOT_ESTABLISHED",
              "UNKNOWN"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "calculation_version": {
      "type": "string",
      "minLength": 1
    },
    "rule_set_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_chart_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "search_coverage": {
      "enum": [
        "DIRECT_ONLY_FOR_SPECIFIED_PAIR",
        "PARTIAL",
        "EXHAUSTIVE_WITHIN_QUESTION_HORIZON",
        "NOT_EVALUATED"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "human_review": {
      "type": "boolean"
    },
    "client_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "expert_text": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}

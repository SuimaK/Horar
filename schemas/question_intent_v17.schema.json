{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Explicit horary question intent / scenario routing input v1.7",
  "type":"object", "additionalProperties":false,
  "required":["schema_version","question_id","intent_code","event_predicate","relationship_kind","question_provenance"],
  "properties":{
    "schema_version":{"const":"1.7"},
    "question_id":{"type":"string","minLength":3,"maxLength":120},
    "intent_code":{"enum":["INBOUND_PERSONAL_MESSAGE","PERSONAL_MEETING","PERSONAL_CONTACT","REPLY_TO_SENT_MESSAGE","CONTACT_RESUMPTION","RECONCILIATION","RETURN_TO_SHARED_HOME","RETURN_TO_RELATIONSHIP","VISITOR_ARRIVAL","DELIVERY_OF_ITEM","LOST_OR_MISSING_PERSON"]},
    "event_predicate":{"enum":["MESSAGE_RECEIVED","SAME_PLACE_IN_PERSON","TWO_WAY_CONTACT_ESTABLISHED","RELATIONSHIP_RESUMED","PHYSICAL_ARRIVAL","DELIVERY_RECEIVED","UNKNOWN"]},
    "relationship_kind":{"enum":["UNRELATED_NAMED_PERSON","SPOUSE","EX_SPOUSE","ROMANTIC_PARTNER","EX_ROMANTIC_PARTNER","CHILD","PARENT","SIBLING","FRIEND","EMPLOYER","UNKNOWN"]},
    "question_provenance":{"enum":["REAL_QUESTION","DEMONSTRATION_NOT_ACTUAL_QUESTION","HISTORICAL_REFERENCE"]},
    "role_approval":{"type":["object","null"],"additionalProperties":false,"required":["approved","method_profile"],"properties":{
      "approved":{"type":"boolean"},"method_profile":{"const":"FRAWLEY_EARLY_PROVISIONAL"},
      "reviewer_id":{"type":"string","minLength":1,"maxLength":120},
      "rationale":{"type":"string","minLength":10,"maxLength":3000}
    }},
    "legacy_payload":{"type":["object","null"],"properties":{
      "question_id":{"type":"string"},"question_kind":{"type":"string"},
      "approve_l1_l7":{"type":"boolean"},"relationship_kind":{"type":"string"}
    },"additionalProperties":true},
    "question_text":{"type":"string","maxLength":4000},
    "context_notes":{"type":"string","maxLength":4000}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/horary/v1.1/role_reception_summary.schema.json",
  "title": "RoleBoundReceptionEvidence 1.1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "chart_id", "source_chart_hash", "question_domain", "reception_evidence_by_actor", "unresolved_actor_pairs", "analysis_status", "caveats", "rule_ids"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "chart_id": {"type": "string"},
    "source_chart_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "question_domain": {"enum": ["RELATIONSHIP","JOB","TRANSACTION","PROPERTY","OTHER"]},
    "reception_evidence_by_actor": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["from_actor_id","to_actor_id","from_planet","to_planet","observations","no_reception_evidence_in_current_profile","rule_id"],
      "properties": {
        "from_actor_id": {"type": "string"}, "to_actor_id": {"type": "string"},
        "from_planet": {"type": "string"}, "to_planet": {"type": "string"},
        "observations": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["dignity_kind","polarity","meaning_hint"],
          "properties": {"dignity_kind": {"type": "string"},"polarity":{"enum":["POSITIVE","NEGATIVE"]},"meaning_hint":{"type":"string"}}}},
        "no_reception_evidence_in_current_profile": {"type": "boolean"},
        "rule_id": {"type": "string"}
      }}},
    "unresolved_actor_pairs": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["from_actor_id", "to_actor_id", "reason"],
      "properties": {"from_actor_id": {"type":"string"},"to_actor_id":{"type":"string"},"reason":{"const":"SIGNIFICATOR_COLLISION_NEEDS_REVIEW"}}}},
    "analysis_status": {"enum":["EVIDENCE_ONLY_NO_VERDICT","NEEDS_EXPERT_REVIEW"]},
    "caveats": {"type": "array", "items":{"type":"string"}},
    "rule_ids": {"type":"array","items":{"type":"string"}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/horary/v1.0/RoleAssignment.schema.json",
  "title": "RoleAssignment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "question_id",
    "chart_id",
    "method_profile",
    "roles_locked",
    "status",
    "assignments"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "chart_id": {
      "type": "string",
      "minLength": 1
    },
    "method_profile": {
      "enum": [
        "frawley_early",
        "oleshko_comparison"
      ]
    },
    "roles_locked": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "CONFIRMED",
        "NEEDS_EXPERT_REVIEW",
        "NEEDS_CLARIFICATION"
      ]
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actor_id",
          "role_kind",
          "radical_house",
          "house_path",
          "base_lord",
          "effective_significator",
          "rule_id",
          "reason",
          "authority_status"
        ],
        "properties": {
          "actor_id": {
            "type": "string",
            "minLength": 1
          },
          "role_kind": {
            "enum": [
              "QUERENT",
              "QUESITED",
              "PROTAGONIST",
              "COUNTERPARTY",
              "OBJECT",
              "MOON_AS_QUERENT_COSIG",
              "NATURAL_SIG",
              "CONTEXT_WITNESS"
            ]
          },
          "radical_house": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "house_path": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          },
          "base_lord": {
            "type": "string",
            "enum": [
              "Sun",
              "Moon",
              "Mercury",
              "Venus",
              "Mars",
              "Jupiter",
              "Saturn"
            ]
          },
          "effective_significator": {
            "type": "string",
            "enum": [
              "Sun",
              "Moon",
              "Mercury",
              "Venus",
              "Mars",
              "Jupiter",
              "Saturn"
            ]
          },
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "authority_status": {
            "enum": [
              "CONFIRMED_EARLY",
              "PENDING_2014",
              "PROJECT",
              "EXPERT_REVIEW"
            ]
          },
          "replacement_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "review_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_chart_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

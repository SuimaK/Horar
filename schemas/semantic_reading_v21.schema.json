{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SemanticReadingEvidence v2.1 — provisional chart-backed interpretation, no event verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "chart_id",
    "source_chart_hash",
    "provenance",
    "method_profile",
    "status",
    "question_intent",
    "roles_confirmed",
    "cards",
    "fact_codes",
    "receptions",
    "direct",
    "indirect",
    "method_coverage",
    "synthesis_state",
    "can_issue_client_verdict",
    "can_issue_event_verdict",
    "final_prediction",
    "timing_prediction"
  ],
  "properties": {
    "schema_version": {
      "const": "2.1"
    },
    "chart_id": {
      "type": "string",
      "minLength": 1
    },
    "source_chart_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provenance": {
      "const": "RECOMPUTED_REAL_EPHEMERIS"
    },
    "method_profile": {
      "const": "FRAWLEY_EARLY_PROVISIONAL"
    },
    "status": {
      "enum": [
        "ROLES_REQUIRED",
        "TOPIC_METHOD_REQUIRED",
        "EVENT_PATHS_REVIEW_ONLY",
        "EVIDENCE_REVIEW_ONLY"
      ]
    },
    "question_intent": {
      "type": "string",
      "maxLength": 64
    },
    "roles_confirmed": {
      "type": "boolean"
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "title",
          "text",
          "source_refs"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          }
        }
      }
    },
    "fact_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "receptions": {
      "type": "object",
      "required": [
        "certain",
        "ambiguous"
      ],
      "additionalProperties": false,
      "properties": {
        "certain": {
          "$ref": "#/$defs/receptionList"
        },
        "ambiguous": {
          "$ref": "#/$defs/receptionList"
        }
      }
    },
    "direct": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "candidates",
        "review_flags",
        "summary"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_SEARCHED",
            "CANDIDATES_REVIEW_ONLY",
            "NONE_IN_CHECKED_SCOPE"
          ]
        },
        "candidates": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "aspect",
              "planet_a",
              "planet_b",
              "status",
              "day_offset",
              "preceding_events",
              "coincident_events"
            ],
            "properties": {
              "aspect": {
                "type": "string"
              },
              "planet_a": {
                "type": "string"
              },
              "planet_b": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "day_offset": {
                "type": "number",
                "minimum": 0
              },
              "preceding_events": {
                "$ref": "#/$defs/eventList"
              },
              "coincident_events": {
                "$ref": "#/$defs/eventList"
              }
            }
          }
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "review_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "indirect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "translation_count",
        "collection_count",
        "summary"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_SEARCHED",
            "GEOMETRY_REVIEW_ONLY"
          ]
        },
        "translation_count": {
          "type": "integer",
          "minimum": 0
        },
        "collection_count": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "method_coverage": {
      "const": "PARTIAL"
    },
    "synthesis_state": {
      "const": "NOT_ADJUDICATED"
    },
    "can_issue_client_verdict": {
      "const": false
    },
    "can_issue_event_verdict": {
      "const": false
    },
    "final_prediction": {
      "type": "null"
    },
    "timing_prediction": {
      "type": "null"
    }
  },
  "$defs": {
    "eventList": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_type",
          "planet",
          "day_offset"
        ],
        "properties": {
          "event_type": {
            "type": "string"
          },
          "planet": {
            "type": "string"
          },
          "day_offset": {
            "type": "number"
          }
        }
      }
    },
    "receptionList": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from_actor",
          "to_actor",
          "from_planet",
          "to_planet",
          "dignity_kind",
          "polarity",
          "certainty"
        ],
        "properties": {
          "from_actor": {
            "type": "string"
          },
          "to_actor": {
            "type": "string"
          },
          "from_planet": {
            "type": "string"
          },
          "to_planet": {
            "type": "string"
          },
          "dignity_kind": {
            "type": "string"
          },
          "polarity": {
            "enum": [
              "POSITIVE",
              "NEGATIVE"
            ]
          },
          "certainty": {
            "enum": [
              "CERTAIN",
              "SECT_DEPENDENT"
            ]
          }
        }
      }
    }
  }
}
